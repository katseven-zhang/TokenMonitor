{
  "name": "tokenmonitor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local Agent usage desktop application",
  "license": "MIT",
  "scripts": {
    "dev": "npm run desktop:dev --prefix desktop",
    "build": "npm run build --prefix desktop",
